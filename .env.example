# Copy this file to .env and fill in real values before running `docker compose up --build`.

# Secret used to sign admin JWTs — use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Admin login used at /admin/login.
ADMIN_USERNAME=admin
# bcrypt hash of the admin password. Generate one from inside backend/ (after `npm install`):
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# IMPORTANT: docker compose expands $ in .env values, and bcrypt hashes are full of $.
# Double every single $ to $$ here, e.g. a hash of $2a$10$abc... becomes $$2a$$10$$abc...
ADMIN_PASSWORD_HASH=

# "manual" = guests submit aso-ebi orders and you mark them paid by hand (e.g. after a bank transfer).
# "paystack" = guests pay online via Paystack at checkout.
PAYMENT_MODE=manual

# Only needed when PAYMENT_MODE=paystack. From your Paystack dashboard.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Restrict CORS to your real domain in production, e.g. https://ourwedding.com
CLIENT_ORIGIN=*

# Host port the site is published on. Defaults to 80 if unset — override here
# (not in docker-compose.yml) if 80 is already taken locally, e.g. by another
# project. Since .env is gitignored, this stays a local override and never
# shows up as a file to commit/revert.
FRONTEND_PORT=80

# Which host interface to publish on. Default 0.0.0.0 = reachable from anywhere
# (fine for local dev, or a server with no reverse proxy in front).
# Set to 127.0.0.1 if nginx/another reverse proxy on this same machine is the
# public entry point and should be the only thing reachable from outside —
# then the container is only reachable via localhost, matching the setup at
# /etc/nginx/sites-enabled/wedding-app proxying to 127.0.0.1:80.
FRONTEND_BIND_HOST=0.0.0.0
